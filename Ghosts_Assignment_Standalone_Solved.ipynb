import random
from typing import List

def my_agent_basic1(game: GhostsGame) -> List:
    """
    Your AI implementation.

    Args:
        game: GhostsGame object with helper methods

    Returns:
        Setup (list of 8 pieces) or Move (list of [piece_id, row, col])
    """

    # ============================================================
    # SETUP PHASE
    # ============================================================
    if game.is_setup_phase() and not game.setup_complete():
        player = game.my_player
        if player == '1':
            good = [(1, 1), (1, 2), (1, 3), (1, 4)]
            evil = [(0, 1), (0, 2), (0, 3), (0, 4)]
        else:
            good = [(4, 1), (4, 2), (4, 3), (4, 4)]
            evil = [(5, 1), (5, 2), (5, 3), (5, 4)]
        return create_custom_setup(player, good, evil)

    # ============================================================
    # Playing phase
    # ============================================================
    moves = game.get_valid_moves()
    if not moves:
        return None

    my_player = game.my_player
    my_pieces = {p['id']: p for p in game.get_my_pieces()}
    opp_positions = {(p['row'], p['col']) for p in game.get_opponent_pieces()}
    revealed = game.get_revealed_pieces()
    revealed_types = {p['id']: p['type'] for p in revealed}

    if my_player == '1':
        exits = [(5, 0), (5, 5)]
    else:
        exits = [(0, 0), (0, 5)]

    def dist_to_exit(r, c):
        return min(abs(r - er) + abs(c - ec) for er, ec in exits)

    def adj_to_opp(r, c):
        for orow, ocol in opp_positions:
            if abs(orow - r) + abs(ocol - c) == 1:
                return True
        return False

    best_score = -1e9
    best_moves = []

    for move in moves:
        pid, r, c = move
        piece = my_pieces[pid]
        t = piece['type']
        orow, ocol = piece['row'], piece['col']

        if t == 'good' and game.is_exit(r, c):
            return move

        score = 0.0

        if t == 'good':
            score += dist_to_exit(orow, ocol) - dist_to_exit(r, c)
        else:
            if my_player == '1':
                score += (r - orow) * 0.2
            else:
                score += (orow - r) * 0.2

        occupant = game.get_piece_at(r, c)
        if occupant is not None and occupant[0] != my_player:
            opp_piece = occupant[1]
            oid = opp_piece['id']
            if oid in revealed_types:
                if revealed_types[oid] == 'good':
                    score += 3.0
                else:
                    score -= 3.0
            else:
                score += 0.5

        if t == 'good' and adj_to_opp(r, c):
            score -= 2.0
        if t == 'evil' and adj_to_opp(r, c):
            score += 0.5

        if score > best_score + 1e-6:
            best_score = score
            best_moves = [move]
        elif abs(score - best_score) <= 1e-6:
            best_moves.append(move)

    return random.choice(best_moves)

import random
from typing import List, Dict

def my_agent_basic(game: GhostsGame) -> List:
    """
    Your AI implementation.

    Args:
        game: GhostsGame object with helper methods

    Returns:
        Setup (list of 8 pieces) or Move (list of [piece_id, row, col])
    """


    if game.is_setup_phase() and not game.setup_complete():
        player = game.my_player

        if player == '1':
            positions = [(0, 1), (0, 2), (0, 3), (0, 4),
                         (1, 1), (1, 2), (1, 3), (1, 4)]
        else:
            positions = [(4, 1), (4, 2), (4, 3), (4, 4),
                         (5, 1), (5, 2), (5, 3), (5, 4)]

        good_positions = random.sample(positions, 4)
        evil_positions = [pos for pos in positions if pos not in good_positions]

        return create_custom_setup(player, good_positions, evil_positions)

    moves = game.get_valid_moves()
    if not moves:
        return None

    my_player = game.my_player
    opponent = game.get_opponent(my_player)

    if my_player == '1':
        exits = [(5, 0), (5, 5)]
    else:
        exits = [(0, 0), (0, 5)]

    def dist_to_exit(r, c):
        return min(abs(r - er) + abs(c - ec) for er, ec in exits)

    def evaluate_state(state: Dict) -> float:
        my_good = game.count_pieces(my_player, 'good', state)
        my_evil = game.count_pieces(my_player, 'evil', state)
        opp_good = game.count_pieces(opponent, 'good', state)
        opp_evil = game.count_pieces(opponent, 'evil', state)

        score = 0.0

        score += (4 - opp_good) * 5.0
        score += my_good * 4.0
        score -= (4 - opp_evil) * 1.5
        score -= (4 - my_evil) * 0.5

        opp_positions = set()
        if opponent in state.get('pieces', {}):
            for p in state['pieces'][opponent]:
                if not p.get('captured', False):
                    opp_positions.add((p['row'], p['col']))

        for piece in state['pieces'][my_player]:
            if piece.get('captured', False):
                continue
            r, c = piece['row'], piece['col']
            if piece.get('type') == 'good':
                d = dist_to_exit(r, c)
                score += (10 - d) * 0.4
                if c in (2, 3):
                    score += 0.2
                for orow, ocol in opp_positions:
                    if abs(orow - r) + abs(ocol - c) == 1:
                        score -= 1.5
                        break
            else:
                for orow, ocol in opp_positions:
                    if abs(orow - r) + abs(ocol - c) == 1:
                        score += 0.7
                        break

        return score

    my_pieces = {p['id']: p for p in game.get_my_pieces()}

    best_score = float('-inf')
    best_moves = []

    for move in moves:
        pid, r, c = move
        piece = my_pieces[pid]
        t = piece['type']

        if t == 'good' and game.is_exit(r, c):
            return move

        new_state = game.simulate_move(move)
        score = evaluate_state(new_state)

        if score > best_score + 1e-6:
            best_score = score
            best_moves = [move]
        elif abs(score - best_score) <= 1e-6:
            best_moves.append(move)

    return random.choice(best_moves)

